# ── Oracle Database ───────────────────────────────────────────────────────────
# Username for the Oracle DB account
DB_USER=your_oracle_username

# Password for the Oracle DB account
DB_PASS=your_oracle_password

# Oracle DSN — format: host:port/service_name
# Example: 192.168.1.10:1521/ORCLPDB1
DB_DSN=hostname:port/service_name


# ── Tracker Behaviour (dbconn3.py) ────────────────────────────────────────────
# Seconds of keyboard/mouse inactivity before the user is considered idle.
# Minimum enforced value: 300 (5 minutes).
DESKTRACKER_IDLE_THRESHOLD=300

# How often (in seconds) accumulated app-time is flushed to the database.
# Default: 900 (15 minutes). Lower this (e.g. 60) for local testing.
DESKTRACKER_BATCH_INTERVAL=900

# Path for the rotating log file produced by the tracker.
# Default: desktracker.log in the current working directory.
DESKTRACKER_LOG_FILE=desktracker.log
